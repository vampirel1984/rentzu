DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/rentzu
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://example.com/rentzu/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://example.com/rentzu/billing/cancel
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://example.com/rentzu/billing
# Modified by AI on 07/18/2026. Edit #1.
# Plan-tier billing per pricing_research.md: one Stripe Price per plan x
# interval. Create these as recurring "per unit" Prices in Stripe (quantity =
# total units on the account) and paste the resulting price IDs here.
STRIPE_PRICE_NORMAL_MONTHLY=
STRIPE_PRICE_NORMAL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Generated by AI on 07/25/2026.
# Native mobile billing (iOS/Android) via RevenueCat 鈥?required because Apple
# and Google require their own in-app-purchase systems for subscriptions that
# unlock in-app features; Stripe Checkout above is web-only. See
# pricing_research.md "Native mobile billing (RevenueCat)".
# Entitlement identifiers you create in the RevenueCat dashboard, one per
# paid plan (attach each plan's App Store/Play Store subscription product to
# its entitlement there). Exposed to the app via GET /billing/plans.
REVENUECAT_ENTITLEMENT_NORMAL=
REVENUECAT_ENTITLEMENT_PRO=
# Shared secret you also paste into RevenueCat's webhook config (Project
# Settings -> Integrations -> Webhooks -> "Authorization header value").
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Display/estimate pricing shown in-app (cents). Keep in sync with the actual
# Stripe Price amounts above 鈥?Stripe is the source of truth for what's charged.
RENTZU_PRICE_NORMAL_MONTHLY_CENTS=199
RENTZU_PRICE_NORMAL_YEARLY_CENTS=1999
RENTZU_PRICE_PRO_MONTHLY_CENTS=299
RENTZU_PRICE_PRO_YEARLY_CENTS=2900
# Voice-to-text quotas (account-wide, resets every 30 days per pricing_research.md).
RENTZU_FREE_VOICE_QUOTA=3
RENTZU_VOICE_QUOTA_PER_UNIT_NORMAL=10
RENTZU_VOICE_QUOTA_PER_UNIT_PRO=30
# Max length (seconds) of a single voice recording, enforced client + server side.
RENTZU_MAX_VOICE_SECONDS=30
# Voice transcription (faster-whisper). Modified by AI on 07/03/2026. Edit #1.
# For Chinese, a larger model is strongly recommended over "tiny" (e.g. "small" or "medium").
WHISPER_MODEL_NAME=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Force a language instead of auto-detect (e.g. zh for Chinese, en for English). Empty = auto.
WHISPER_LANGUAGE=
# Optional prompt to bias output; for Simplified Chinese try: 浠ヤ笅鏄櫘閫氳瘽鐨勫彞瀛愩€?
WHISPER_INITIAL_PROMPT=
