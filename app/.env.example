# Generated by AI on 07/25/2026.
# Client-side env vars for the Expo app. Expo automatically inlines any
# EXPO_PUBLIC_* variable into the JS bundle at build time, so these are safe
# to expose (RevenueCat's SDK keys are designed to ship inside the client).
#
# Copy this file to .env and fill in your RevenueCat public SDK keys (get
# these from the RevenueCat dashboard -> Project Settings -> API Keys).
# Requires a custom dev client / EAS build — react-native-purchases does NOT
# work in Expo Go. See ../PRICING_IMPLEMENTATION_TESTING.md for setup.
EXPO_PUBLIC_REVENUECAT_IOS_SDK_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_SDK_KEY=

# Base URL of the Rentzu FastAPI backend. Leave unset for local emulator
# development, where the app falls back to http://10.0.2.2:8000 (the Android
# emulator's alias for the host machine's localhost). Any build installed on a
# real device — especially Play Store testing tracks — must set this to a
# publicly reachable HTTPS URL. Android blocks cleartext HTTP by default.
EXPO_PUBLIC_API_BASE_URL=
